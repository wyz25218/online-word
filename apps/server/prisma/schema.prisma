// Prisma schema：业务库（仅 apps/server 可写，账号 ow_app）
// 协同二进制表（doc_snapshots/doc_updates/doc_sync_cursors）不走 Prisma，
// 由 apps/collab 的最小 DB client + 原生 SQL 迁移管理（见 docs/03-data-model.md 第 2 节）。
//
// Prisma 7 变更：
// - datasource 不再支持 url：迁移连接串在 prisma.config.ts，运行时用 @prisma/adapter-pg 注入 PrismaClient
// - generator 必须为 prisma-client 且显式 output；CLI 不再自动加载 .env
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// T1.2 最小集：docs + doc_members（docs/03 §2 DDL）。
// 协同二进制表（doc_snapshots/doc_updates/doc_sync_cursors）归 T1.3 的
// collab 原生 SQL 迁移，绝不进入本 schema（ow_app 无对应表权限）。
model Doc {
  id             String    @id @default(uuid()) @db.Uuid
  title          String    @default("未命名文档")
  ownerId        String    @map("owner_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6) // 软删除
  currentVersion BigInt    @default(0) @map("current_version") // 最新快照点版本（collab 经内部接口回写）
  lastActiveAt   DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)

  members     DocMember[]
  attachments Attachment[]
  comments    Comment[]

  @@index([ownerId], map: "idx_docs_owner")
  @@map("docs")
}

model DocMember {
  docId     String   @map("doc_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String // CHECK 约束在迁移 SQL 中（owner/editor/commenter/viewer）
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@id([docId, userId])
  @@index([userId], map: "idx_doc_members_user")
  @@map("doc_members")
}

// T2.1：附件元数据（二进制在对象存储，客户端签名直传后登记）
model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  docId      String   @map("doc_id") @db.Uuid
  uploaderId String   @map("uploader_id") @db.Uuid
  objectKey  String   @unique @map("object_key") // MinIO/S3 key
  mimeType   String   @map("mime_type")
  sizeBytes  BigInt   @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId], map: "idx_attachments_doc")
  @@map("attachments")
}

// T2.3：评论冗余（权威数据在 Y.Doc 的 comments 命名空间，由 collab 经内部接口抽取回写；
// 供跨文档查询/通知/未读数使用，docs/03 §2 DDL）
model Comment {
  id        String   @id @db.Uuid // 即 Y 侧评论 id（线程 id = 首评 id），回写幂等 upsert 依据
  docId     String   @map("doc_id") @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  resolved  Boolean  @default(false) // 线程级状态冗余到该线程每行
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt], map: "idx_comments_doc") // 未读部分索引在手写迁移 SQL 中（Prisma 不支持 WHERE）
  @@map("comments")
}
