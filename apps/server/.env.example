# apps/server 业务后端环境变量（复制为 .env 使用；.env 已被 gitignore）

# HTTP 监听端口
PORT=3000

# PostgreSQL 业务库（server 使用 app 账号：业务表全部权限，无二进制表写权限）
DATABASE_URL=postgresql://ow_app:ow_app_dev@localhost:5432/online_word

# Redis（鉴权缓存、踢人 Pub/Sub；collab 共用同一实例）
REDIS_URL=redis://localhost:6379

# JWT 密钥（生产必须换成随机长密钥并走密钥管理）
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# WS token 专用密钥（与 access 隔离，防止通用令牌冒用；collab 网关验签需持有同一密钥，T1.5 接入）
JWT_COLLAB_SECRET=dev-collab-secret-change-me

# 令牌有效期
ACCESS_TOKEN_TTL_SEC=900          # 15min
REFRESH_TOKEN_TTL_SEC=604800      # 7d
COLLAB_TOKEN_TTL_SEC=300          # WS token 5min

# 内部接口鉴权（server <-> collab）
INTERNAL_API_KEY=dev-internal-key

# 对象存储（S3 兼容；dev 本机 SeaweedFS，prod 为 MinIO/S3）
# forcePathStyle 模式：endpoint + /bucket/key
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=owdev
S3_SECRET_ACCESS_KEY=owdev-dev-secret
S3_BUCKET=ow-attachments
# 浏览器可达的公读前缀（dev 走 Vite /s3proxy 代理 → 9000；prod 由 nginx 同名 location 反代）
S3_PUBLIC_PREFIX=/s3proxy
# 签名直传 URL 有效期（秒）
S3_UPLOAD_URL_TTL_SEC=600
# 单文件大小上限（MB）
S3_MAX_UPLOAD_MB=50
