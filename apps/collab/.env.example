# apps/collab 协作网关环境变量（复制为 .env 使用；.env 已被 gitignore）

# WS 监听端口
PORT=8080

# 允许的前端 Origin（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL 协同库（collab 使用最小权限账号：仅 doc_snapshots/doc_updates/doc_sync_cursors）
DATABASE_URL=postgresql://ow_collab:ow_collab_dev@localhost:5432/online_word

# Redis（分布式锁、鉴权缓存、踢人 Pub/Sub）
REDIS_URL=redis://localhost:6379

# 业务后端内部接口
SERVER_INTERNAL_URL=http://localhost:3000
INTERNAL_API_KEY=dev-internal-key
