{
  "name": "@online-word/shared",
  "version": "0.0.0",
  "private": true,
  "description": "web/server/collab 三端共享的类型与常量（角色、Awareness 用户、鉴权响应、WS 指令）",
  "type": "module",
  "main": "./dist/index.js",
